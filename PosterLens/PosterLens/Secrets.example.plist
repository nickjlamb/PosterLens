<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required. Powers summaries, categories, chat and author questions.
	     Get one at https://platform.openai.com/ -->
	<key>OpenAI_API_Key</key>
	<string>YOUR_OPENAI_API_KEY</string>

	<!-- Optional. Related-research discovery on the legacy Perplexity path.
	     Get one at https://www.perplexity.ai/ -->
	<key>Perplexity_API_Key</key>
	<string></string>

	<!-- Optional. The PubMed RAG backend in functions/.
	     Only needed if you deploy your own Cloud Function and gateway. -->
	<key>Evidence_API_Key</key>
	<string></string>
</dict>
</plist>
